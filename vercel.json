{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/paginas/landing.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/paginas/:path*",
      "destination": "/public/paginas/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.php"
    }
  ]
}
